{
  "name": "Gavium",
  "short_name": "Gavium",
  "id": "/",
  "description": "Secretario pessoal e academico para rotina, faculdade, compromissos e lembretes.",
  "start_url": "/",
  "scope": "/",
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "display_override": ["standalone", "minimal-ui"],
  "display": "standalone",
  "background_color": "#f8fafc",
  "theme_color": "#15161a",
  "orientation": "portrait-primary",
  "categories": ["productivity", "education", "utilities"],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/maskable-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Registrar falta",
      "short_name": "Falta",
      "description": "Registrar faltas rapidamente",
      "url": "/quick/absence",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Adicionar nota",
      "short_name": "Nota",
      "description": "Adicionar uma nota de disciplina",
      "url": "/quick/grade",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Nova tarefa",
      "short_name": "Tarefa",
      "description": "Criar uma tarefa rapidamente",
      "url": "/quick/task",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Criar lembrete",
      "short_name": "Lembrete",
      "description": "Criar um lembrete rapidamente",
      "url": "/quick/reminder",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Novo compromisso",
      "short_name": "Agenda",
      "description": "Criar um compromisso rapidamente",
      "url": "/quick/event",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
